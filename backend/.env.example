# Server-only Zestiva -> Fiteatsy delegated authority validation.
# Supply the PEM through deployment secret management; never commit key material.
ZESTIVA_DELEGATION_PUBLIC_KEY=
ZESTIVA_DELEGATION_KEY_ID=
ZESTIVA_DELEGATION_ISSUER=zestiva-platform
ZESTIVA_DELEGATION_AUDIENCE=fiteatsy-backend
ZESTIVA_DELEGATION_CLOCK_SKEW_SECONDS=5

# Required outside tests for Redis-backed replay protection.
REDIS_URL=
