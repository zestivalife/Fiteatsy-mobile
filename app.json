{
  "expo": {
    "name": "Fiteatsy",
    "slug": "fiteatsy-health-app",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0-native-20260825-health-connect-d2",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fiteatsy.health",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_DISTANCE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#191533"
      },
      "package": "com.fiteatsy.health"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/favicon.png"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/70254234-571c-4351-87d9-33e8f851dde1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "apiBaseUrl": "https://fiteatsy-mobile-production.up.railway.app",
      "eas": {
        "projectId": "70254234-571c-4351-87d9-33e8f851dde1"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fiteatsy to access your photos for health report upload.",
          "cameraPermission": "Allow Fiteatsy to use your camera to capture health reports."
        }
      ],
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissionDelegate",
      "expo-video",
      "./plugins/withFrozenSplashBridge"
    ]
  }
}
